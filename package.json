{
  "name": "ahm0xc",
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@10.0.0",
  "scripts": {
    "dev": "turbo dev",
    "build": "turbo build",
    "check": "pnpm run check-types && pnpm run fmt:check && pnpm run lint",
    "check-types": "turbo check-types",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "doctor": "pnpm --filter web run doctor",
    "fmt": "oxfmt \"apps/**/*.{ts,tsx,js,jsx,mdx}\" \"packages/**/*.{ts,tsx,js,jsx,mdx}\"",
    "fmt:check": "oxfmt --check \"apps/**/*.{ts,tsx,js,jsx,mdx}\" \"packages/**/*.{ts,tsx,js,jsx,mdx}\"",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "lefthook": "^2.2.2",
    "oxfmt": "^0.79.0",
    "oxlint": "^1.94.0",
    "turbo": "^2.10.2"
  },
  "peerDependencies": {
    "typescript": "~7.0.2"
  }
}
